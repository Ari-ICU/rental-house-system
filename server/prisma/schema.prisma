generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rental {
  id                    Int      @id @default(autoincrement())
  ClientName            String
  roomNumber            String
  status                String
  rentAmount            Decimal
  startDate             String?
  endDate               String?
  notes                 String?
  clientPhone           String?
  clientEmail           String?
  clientAddress         String?
  clientIDCard          String?
  clientImageCardFront  String?
  clientImageCardBack   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  telegramChatId        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  image                 String?
  bills                 Bill[]

  @@index([ClientName])
  @@index([roomNumber])
  @@index([clientPhone])
  @@index([status])
  @@map("rentals")
}

model Bill {
  id                Int      @id @default(autoincrement())
  rentalId          Int
  rental            Rental   @relation(fields: [rentalId], references: [id])
  month             String
  rentAmount        Decimal?
  
  // Meter Readings
  prevElectricityReading Decimal @default(0)
  currElectricityReading Decimal @default(0)
  prevWaterReading       Decimal @default(0)
  currWaterReading       Decimal @default(0)
  
  electricityAmount Decimal
  waterAmount       Decimal
  electricityStatus String   // "Paid" | "Unpaid"
  waterStatus       String   // "Paid" | "Unpaid"
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rentalId])
  @@index([month])
  @@map("bills")
}

model Report {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  status      String   // "Completed" | "In-Review"
  startDate   DateTime?
  endDate     DateTime?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}

model SystemSetting {
  id                     Int      @id @default(1)
  telegramBotToken       String?
  telegramChatId         String?
  telegramLanguage       String   @default("en")
  paymentBakongAccountId String?
  paywayMerchantId       String?
  paywayApiKey           String?
  
  // Utility Rates
  electricityRate        Decimal  @default(0)
  waterRate              Decimal  @default(0)
  exchangeRate           Decimal  @default(4100)
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}
