generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rental {
  id                    Int      @id @default(autoincrement())
  ClientName            String
  roomNumber            String
  status                String
  rentAmount            Decimal  @default(50)
  depositAmount         Decimal  @default(0)
  startDate             String?
  endDate               String?
  notes                 String?
  clientPhone           String?
  clientEmail           String?
  clientAddress         String?
  nationality           String?
  gender                String?
  occupation            String?
  idCardType            String?
  memberCount           Int      @default(1)
  clientIDCard          String?
  clientImageCardFront  String?
  clientImageCardBack   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  telegramChatId        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  image                 String?
  bills                 Bill[]

  @@index([ClientName])
  @@index([roomNumber])
  @@index([clientPhone])
  @@index([status])
  @@map("rentals")
}

model Bill {
  id                Int      @id @default(autoincrement())
  rentalId          Int
  rental            Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  month             String
  rentAmount        Decimal?
  
  // Meter Readings
  prevElectricityReading Decimal @default(0)
  currElectricityReading Decimal @default(0)
  prevWaterReading       Decimal @default(0)
  currWaterReading       Decimal @default(0)
  
  electricityAmount Decimal
  waterAmount       Decimal
  electricityStatus String   // "Paid" | "Unpaid"
  waterStatus       String   // "Paid" | "Unpaid"
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([rentalId])
  @@index([month])
  @@map("bills")
}

model Report {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  status      String   @default("Pending") // "Pending", "Generating", "In-Review", "Completed", "Archived"
  startDate   DateTime?
  endDate     DateTime?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reports")
}

model SystemSetting {
  id                     Int      @id @default(1)
  telegramBotToken       String?
  telegramChatId         String?
  telegramLanguage       String   @default("en")
  paymentBakongAccountId String?
  paywayMerchantId       String?
  paywayApiKey           String?
  
  // Utility Rates
  electricityRate        Decimal  @default(0)
  waterRate              Decimal  @default(0)
  exchangeRate           Decimal  @default(4100)
  
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("system_settings")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER") // "ADMIN" | "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("Pending") // "Pending", "Resolved", "Closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // "Maintenance", "Tax", "Salary", "Utility", "Other"
  amount      Decimal
  date        DateTime @default(now())
  description String?
  fileUrl     String?  // For receipt images/PDFs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@map("expenses")
}

model Camera {
  id        Int      @id @default(autoincrement())
  name      String
  floor     String
  streamUrl String?
  deviceId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cameras")
}

