# Backend Server Port
PORT=4000

# Environment Mode (development, production, testing)
NODE_ENV=development

# Database Connection URI (Uses PostgreSQL)
# For local setup running outside docker, connect to port 5433 (exposed by docker-compose)
DATABASE_URL="postgresql://postgres:password@localhost:5433/rental_db?schema=public"

# JSON Web Token Secret Key
JWT_SECRET="your_jwt_secret_key_change_me_in_production"

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# Telegram Bot Notification Settings (Optional)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
